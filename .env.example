# ============================================================================
# VARIABLES DE ENTORNO - GESTOR DE CALIFICACIONES
# ============================================================================
# Copia este archivo como .env y ajusta los valores para tu entorno local.
# Ejemplo: cp .env.example .env
#
# NUNCA versionees el archivo .env (ya esta excluido en .gitignore).
# ============================================================================

# 1. Base de Datos (PostgreSQL)
# ---------------------------------------------------------------------------
DB_NAME=gestor_calificaciones
DB_USER=postgres
DB_PASSWORD=postgres

# URL JDBC para Spring Boot (conecta con el servicio db de docker-compose)
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/gestor_calificaciones

# 2. Seguridad JWT
# ---------------------------------------------------------------------------
# Genera una clave segura con: openssl rand -base64 64
JWT_SECRET=tu-clave-secreta-aqui-cambia-esta-linea

# 3. Frontend (CORS)
# ---------------------------------------------------------------------------
# URL del frontend para la politica CORS del backend
FRONTEND_URL=http://localhost:4200

# 4. Boletas
# ---------------------------------------------------------------------------
# Ruta donde se almacenan las boletas generadas
BOLETAS_PATH=./boletas

# 5. Servidor Backend
# ---------------------------------------------------------------------------
# Puerto del servidor Spring Boot (default: 8080)
PORT=8080

# 6. Perfil de Spring
# ---------------------------------------------------------------------------
# Perfil activo: dev (desarrollo local) o prod (produccion)
SPRING_PROFILES_ACTIVE=dev
